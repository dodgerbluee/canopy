{
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

{$CANOPY_SITE:localhost} {
	encode zstd gzip
	@api path /api/* /mcp /agent/* /healthz /readyz
	handle @api {
		reverse_proxy {$CANOPY_API_UPSTREAM:127.0.0.1:8080} {
			flush_interval -1
		}
	}
	# Never turn a missing icon into a cacheable HTML response.
	@icons path /favicon* /canopy-icon* /apple-touch-icon* /icons/*
	handle @icons {
		root * /srv
		header Cache-Control "no-cache"
		header X-Content-Type-Options "nosniff"
		file_server
	}
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
