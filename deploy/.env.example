CANOPY_IMAGE_PREFIX=ghcr.io/dodgerbluee/canopy
CANOPY_VERSION=local
# Generate a hex database password: openssl rand -hex 32
POSTGRES_PASSWORD=
# Only creates the first owner. Changing it never resets an existing owner.
CANOPY_INITIAL_PASSWORD=
# Your browser/agent address, including host port.
CANOPY_PUBLIC_URL=http://localhost:7080
CANOPY_PORT=7080
