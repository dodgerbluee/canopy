# Set to your lower-case GitHub owner/repository; workflows derive this value.
CANOPY_IMAGE_PREFIX=ghcr.io/your-owner/your-repository
# dev for development builds, a version such as 1.0.0 for releases.
CANOPY_VERSION=dev
# Public DNS hostname only, without scheme, path or port. Caddy obtains TLS.
CANOPY_SITE=garden.example.com
# Generate with: openssl rand -hex 32 (hex is safe inside the database URL).
POSTGRES_PASSWORD=
# Absolute directory on this Linux Docker host, mounted at the same path.
CANOPY_WORK_DIR=/srv/canopy/work
# Linux: stat -c '%g' /var/run/docker.sock
DOCKER_GID=0
CANOPY_MCP_ENABLED=true
HTTP_PORT=80
HTTPS_PORT=443
