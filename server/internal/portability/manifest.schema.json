{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canopy.local/schemas/backup-manifest-r1.json",
  "title": "Canopy backup manifest (r1)",
  "description": "External manifest written beside every backup set as <set>.manifest.json. The same document (without payloadSha256) is stored inside the archive as manifest.json. Restore verifies payloadSha256 over the archive file exactly as stored, then every entry hash before writing anything.",
  "type": "object",
  "required": [
    "schemaVersion", "backupSet", "createdAt", "privacyEpoch", "sealed",
    "tableCounts", "financialTotals", "allocationTotalMinor", "tombstones",
    "entries", "exclusions", "backupDuration"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "r1" },
    "backupSet": { "$ref": "#/$defs/uuid" },
    "createdAt": { "type": "string", "format": "date-time" },
    "privacyEpoch": { "type": "integer", "minimum": 0 },
    "sealed": { "type": "boolean" },
    "tableCounts": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z_]+$" },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "financialTotals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["currency", "totalMinor"],
        "additionalProperties": false,
        "properties": {
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "totalMinor": { "type": "integer" }
        }
      }
    },
    "allocationTotalMinor": { "type": "integer", "minimum": 0 },
    "tombstones": { "type": "integer", "minimum": 0 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    },
    "payloadSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the archive file exactly as stored (.tar or .tar.enc). Present only in the external manifest."
    },
    "exclusions": { "type": "array", "items": { "type": "string" } },
    "backupDuration": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(ns|µs|ms|s|m|h)+$",
      "description": "Go duration string for the snapshot window."
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "entry": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(manifest\\.json|db/[a-z_]+\\.jsonl|river/river_job\\.jsonl|media/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$",
          "description": "Relative, cleaned, non-escaping archive path. Restore re-validates every path and refuses anything outside these four positions."
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
